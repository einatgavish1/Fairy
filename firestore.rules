rules_version = '2';

// Fairy: invoices and receipts read from PDFs and photos.
// - The owners always have access and manage sharing from the app ("שיתוף"), which writes
//   one document per shared email to /access/{email}. The list lives in Firestore rather
//   than in this file because the repo is public. Keep the owners in step with firebase-config.js.
// - A shared user can read and edit the documents and see only their own access doc.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
          && (request.auth.token.email_verified == true
              || request.auth.token.firebase.sign_in_provider == 'password');
    }
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email in ['einatgavish1@gmail.com', 'gavishori@gmail.com'];
    }
    function allowed() {
      return isOwner()
          || (signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.token.email)));
    }
    function validDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['client', 'date', 'supplier', 'supplierId', 'category', 'docType', 'docNo', 'details',
                               'amount', 'vat', 'fileName', 'fileHash', 'customer', 'status', 'reviewWhy', 'account', 'accountBy', 'notDup', 'checked', 'kind', 'title', 'driveId', 'currency', 'origAmount', 'origVat', 'rate', 'rateDate', 'text', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && (d.amount == null || d.amount is number)
          && (d.vat == null || d.vat is number)
          && d.date is string && d.supplier is string && d.details is string
          && d.details.size() < 2000
          && (!('text' in d) || (d.text is string && d.text.size() < 40000))
          // paid in a foreign currency: the amount as paid and the representative rate it was recorded at
          && (!('currency' in d) || d.currency in ['', 'USD', 'EUR', 'GBP'])
          && (!('origAmount' in d) || d.origAmount == null || d.origAmount is number)
          && (!('origVat' in d) || d.origVat == null || d.origVat is number)
          && (!('rate' in d) || d.rate == null || (d.rate is number && d.rate > 0 && d.rate < 100))
          && (!('rateDate' in d) || (d.rateDate is string && d.rateDate.size() <= 10))
          // kind "misc": one of the client's other documents (a rent contract, form 106...), not an expense
          && (!('kind' in d) || d.kind in ['', 'misc'])
          && (!('title' in d) || (d.title is string && d.title.size() <= 150))
          // driveId: the document's original file in Google Drive
          && (!('driveId' in d) || (d.driveId is string && d.driveId.size() <= 100))
          // checked: a person went over the document (the green tick)
          && (!('checked' in d) || d.checked is bool)
          && (!('notDup' in d) || (d.notDup is list && d.notDup.size() < 50))
          && (!('status' in d) || d.status in ['ok', 'review', 'failed'])
          && (!('reviewWhy' in d) || (d.reviewWhy is string && d.reviewWhy.size() < 3000));
    }

    match /docs/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed() && validDoc();
    }

    // The small picture of each document, kept apart so the list loads fast.
    match /previews/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
                            && request.resource.data.keys().hasOnly(['dataUrl'])
                            && request.resource.data.dataUrl is string
                            && request.resource.data.dataUrl.size() < 900000;
    }

    // The client list, so a new client is there before their first document.
    match /clients/{id} {
      allow read: if allowed();
      // dealer: an exempt dealer (עוסק פטור) or a licensed one (עוסק מורשה), set when the client is added;
      // dealerLog keeps every change (from which date, when, by whom). Only the owners change it.
      allow create: if allowed()
                    && request.resource.data.keys().hasOnly(['name', 'dealer', 'dealerLog', 'createdAt', 'createdBy'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
                    && (!('dealer' in request.resource.data) || request.resource.data.dealer in ['exempt', 'licensed'])
                    && (!('dealerLog' in request.resource.data) || (request.resource.data.dealerLog is list && request.resource.data.dealerLog.size() < 50));
      allow update: if isOwner()
                    && request.resource.data.keys().hasOnly(['name', 'dealer', 'dealerLog', 'createdAt', 'createdBy'])
                    && (!('dealer' in request.resource.data) || request.resource.data.dealer in ['exempt', 'licensed'])
                    && (!('dealerLog' in request.resource.data) || (request.resource.data.dealerLog is list && request.resource.data.dealerLog.size() < 50))
                    // the history only grows: a change is added to it, never taken out
                    && (!('dealerLog' in resource.data) || ('dealerLog' in request.resource.data && request.resource.data.dealerLog.size() >= resource.data.dealerLog.size()));
      allow delete: if isOwner();
    }

    // A client's filing report for one tax year: the comparative report's lines and the details around them.
    match /reports/{id} {
      allow read: if allowed();
      allow create, update: if allowed()
                            && request.resource.data.keys().hasOnly(['client', 'year', 'idNumber', 'fileNo', 'carPct', 'mealPct',
                                                                     'source', 'fileName', 'lines', 'updatedAt', 'updatedBy'])
                            && request.resource.data.client is string
                            && request.resource.data.lines is list && request.resource.data.lines.size() < 1000;
      allow delete: if isOwner();
    }

    match /access/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email == email);
      allow create, update: if isOwner()
                            && email == email.lower()
                            && request.resource.data.keys().hasOnly(['addedAt', 'addedBy']);
      allow delete: if isOwner();
    }
  }
}
