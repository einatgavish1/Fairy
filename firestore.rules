rules_version = '2';

// Fairy: invoices and receipts read from PDFs and photos.
// - The owners always have access and manage sharing from the app ("שיתוף"), which writes
//   one document per shared email to /access/{email}. The list lives in Firestore rather
//   than in this file because the repo is public. Keep the owners in step with firebase-config.js.
// - A shared user can read and edit the documents and see only their own access doc.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
          && (request.auth.token.email_verified == true
              || request.auth.token.firebase.sign_in_provider == 'password');
    }
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email in ['einatgavish1@gmail.com', 'gavishori@gmail.com'];
    }
    function allowed() {
      return isOwner()
          || (signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.token.email)));
    }
    function validDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['client', 'date', 'supplier', 'supplierId', 'category', 'docType', 'docNo', 'details',
                               'amount', 'vat', 'fileName', 'fileHash', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && (d.amount == null || d.amount is number)
          && (d.vat == null || d.vat is number)
          && d.date is string && d.supplier is string && d.details is string
          && d.details.size() < 2000;
    }

    match /docs/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed() && validDoc();
    }

    // The small picture of each document, kept apart so the list loads fast.
    match /previews/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
                            && request.resource.data.keys().hasOnly(['dataUrl'])
                            && request.resource.data.dataUrl is string
                            && request.resource.data.dataUrl.size() < 900000;
    }

    match /access/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email == email);
      allow create, update: if isOwner()
                            && email == email.lower()
                            && request.resource.data.keys().hasOnly(['addedAt', 'addedBy']);
      allow delete: if isOwner();
    }
  }
}
